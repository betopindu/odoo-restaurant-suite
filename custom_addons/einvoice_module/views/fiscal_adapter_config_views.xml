<odoo>
    <record id="view_fiscal_adapter_config_tree" model="ir.ui.view">
        <field name="name">fiscal.adapter.config.tree</field>
        <field name="model">fiscal.adapter.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="tenant_id"/>
                <field name="company_id"/>
                <field name="country_code"/>
                <field name="adapter_code"/>
                <field name="environment"/>
                <field name="numbering_strategy"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_fiscal_adapter_config_form" model="ir.ui.view">
        <field name="name">fiscal.adapter.config.form</field>
        <field name="model">fiscal.adapter.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="tenant_id"/>
                            <field name="company_id"/>
                            <field name="country_code"/>
                            <field name="adapter_code"/>
                            <field name="environment"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="credentials_mode"/>
                            <field name="certificate_ref"/>
                            <field name="private_key_ref"/>
                            <field name="api_client_id"/>
                            <field name="token_ref"/>
                        </group>
                    </group>
                    <group string="Numbering">
                        <field name="numbering_strategy"/>
                        <field name="sequence_prefix"/>
                        <field name="sequence_id"/>
                    </group>
                    <group string="Transport">
                        <field name="endpoint_base_url"/>
                        <field name="timeout_seconds"/>
                        <field name="max_retry_count"/>
                    </group>
                    <group string="Metadata">
                        <field name="metadata_json"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fiscal_adapter_config" model="ir.actions.act_window">
        <field name="name">Adapter Configs</field>
        <field name="res_model">fiscal.adapter.config</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
