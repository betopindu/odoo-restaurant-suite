<odoo>
    <record id="rule_fiscal_tenant_user_allowed" model="ir.rule">
        <field name="name">Fiscal tenants: allowed tenants</field>
        <field name="model_id" ref="model_fiscal_tenant"/>
        <field name="domain_force">[('id', 'in', user.allowed_fiscal_tenant_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

