        <field name="name">Fiscal tenants: administrators all</field>
        <field name="model_id" ref="model_fiscal_tenant"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
