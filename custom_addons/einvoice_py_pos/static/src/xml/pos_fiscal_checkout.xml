<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="einvoice_py_pos.PaymentScreenFiscalChoice"
       t-inherit="point_of_sale.PaymentScreenButtons"
       t-inherit-mode="extension">
        <xpath expr="//button[contains(@class, 'js_invoice')]" position="attributes">
            <attribute name="t-if">!pos.config.py_fiscal_checkout_enabled</attribute>
        </xpath>
        <xpath expr="//button[contains(@class, 'js_invoice')]" position="after">
            <button t-if="pos.config.py_fiscal_checkout_enabled"
                    class="button py-fiscal-choice btn btn-light py-3 text-start rounded-0 border-bottom"
                    t-att-class="{ 'highlight text-bg-primary': currentOrder.pyFiscalChoice }"
                    t-on-click="selectPyFiscalChoice">
                <i class="fa fa-file-text-o me-2"/>
                <t t-esc="pyFiscalChoiceLabel"/>
            </button>
        </xpath>
    </t>

    <t t-name="einvoice_py_pos.ReceiptScreenFiscalStatus"
       t-inherit="point_of_sale.ReceiptScreen"
       t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'actions')]/div/h1" position="after">
            <div t-if="showPyFiscalStatus"
                 class="alert mt-3 mb-2 text-start"
                 t-att-class="pyFiscalStatusClass"
                 role="status"
                 aria-live="polite">
                <div class="d-flex align-items-center gap-2 fw-bold fs-4">
                    <i class="fa" t-att-class="pyFiscalStatusIcon"/>
                    <span t-esc="pyFiscalStatusLabel"/>
                </div>
                <div t-if="pyFiscalStatus.message" class="mt-2" t-esc="pyFiscalStatus.message"/>
                <div t-if="pyFiscalStatus.authority_code" class="mt-2">
                    <strong>SIFEN:</strong>
                    <span t-esc="pyFiscalStatus.authority_code"/>
                </div>
                <div t-if="pyFiscalStatus.cdc" class="text-break">
                    <strong>CDC:</strong>
                    <span t-esc="pyFiscalStatus.cdc"/>
                </div>
                <div t-if="pyFiscalStatus.authority_protocol">
                    <strong>Protocol:</strong>
                    <span t-esc="pyFiscalStatus.authority_protocol"/>
                </div>
                <div t-if="pyFiscalStatus.delivery_ready" class="d-flex gap-2 mt-3 flex-wrap">
                    <button class="btn btn-primary"
                            t-on-click="() => this.openPyAuthoritativeFile('pdf')">
                        <i class="fa fa-print me-1"/>Open / Print KuDE
                    </button>
                    <button class="btn btn-secondary"
                            t-on-click="() => this.openPyAuthoritativeFile('xml')">
                        <i class="fa fa-download me-1"/>Download XML
                    </button>
                    <button t-if="pyFiscalStatus.email_available"
                            class="btn btn-secondary"
                            t-att-disabled="pyFiscalStatus.emailSending"
                            t-on-click="resendPyFiscalEmail">
                        <i class="fa fa-envelope me-1"/>Email KuDE + XML
                    </button>
                </div>
                <div t-if="pyFiscalStatus.delivery_ready and pyFiscalStatus.email_status != 'not_requested'"
                     class="small mt-2">
                    <strong>Email:</strong>
                    <span t-esc="pyFiscalStatus.email_status"/>
                </div>
                <small class="d-block mt-2 text-muted">Automatic retries are disabled.</small>
            </div>
        </xpath>
    </t>
</templates>
