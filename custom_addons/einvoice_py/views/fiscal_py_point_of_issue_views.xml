<odoo>
    <record id="view_fiscal_py_point_of_issue_tree" model="ir.ui.view">
        <field name="name">fiscal.py.point.of.issue.tree</field>
        <field name="model">fiscal.py.point.of.issue</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="establishment_id"/>
                <field name="tenant_id"/>
                <field name="company_id"/>
                <field name="sequence_id"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_fiscal_py_point_of_issue_form" model="ir.ui.view">
        <field name="name">fiscal.py.point.of.issue.form</field>
        <field name="model">fiscal.py.point.of.issue</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="establishment_id"/>
                        <field name="tenant_id"/>
                        <field name="company_id"/>
                        <field name="sequence_id"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fiscal_py_point_of_issue" model="ir.actions.act_window">
        <field name="name">Paraguay Points of Issue</field>
        <field name="res_model">fiscal.py.point.of.issue</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
