<odoo>
    <record id="view_py_fiscal_email_delivery_wizard_form" model="ir.ui.view">
        <field name="name">py.fiscal.email.delivery.wizard.form</field>
        <field name="model">py.fiscal.email.delivery.wizard</field>
        <field name="arch" type="xml">
            <form string="Email Authoritative Fiscal Documents">
                <sheet>
                    <field name="document_id" invisible="1"/>
                    <field name="delivery_id" invisible="1"/>
                    <group>
                        <field name="recipient_email"/>
                        <field name="subject"/>
                    </group>
                    <div class="alert alert-warning" role="alert">
                        <field name="warning" nolabel="1"/>
                    </div>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="Queue Email"
                            class="btn-primary" groups="einvoice_py.group_py_fiscal_operator"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
