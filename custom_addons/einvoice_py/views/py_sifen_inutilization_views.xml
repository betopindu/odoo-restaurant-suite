<odoo>
    <record id="view_fiscal_py_inutilization_tree" model="ir.ui.view">
        <field name="name">fiscal.py.inutilization.tree</field>
        <field name="model">fiscal.py.inutilization</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0">
                <field name="environment"/>
                <field name="timbrado_id"/>
                <field name="establishment_id"/>
                <field name="point_of_issue_id"/>
                <field name="document_type"/>
                <field name="number_from"/>
                <field name="number_to"/>
                <field name="occurred_on"/>
                <field name="state"/>
                <field name="authority_code"/>
                <field name="started_at"/>
            </tree>
        </field>
    </record>

    <record id="view_fiscal_py_inutilization_form" model="ir.ui.view">
        <field name="name">fiscal.py.inutilization.form</field>
        <field name="model">fiscal.py.inutilization</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="tenant_id"/>
                        <field name="company_id"/>
                        <field name="environment"/>
                        <field name="state"/>
                    </group>
                    <group string="Fiscal Range">
                        <field name="timbrado_id"/>
                        <field name="establishment_id"/>
                        <field name="point_of_issue_id"/>
                        <field name="document_type"/>
                        <field name="number_from"/>
                        <field name="number_to"/>
                        <field name="occurred_on"/>
                        <field name="reason"/>
                    </group>
                    <group string="Safe Evidence">
                        <field name="event_id"/>
                        <field name="request_hash"/>
                        <field name="response_hash"/>
                        <field name="http_status"/>
                        <field name="duration_ms"/>
                        <field name="authority_code"/>
                        <field name="authority_message"/>
                        <field name="authority_protocol"/>
                        <field name="started_at"/>
                        <field name="finished_at"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fiscal_py_inutilization" model="ir.actions.act_window">
        <field name="name">Paraguay Number Inutilizations</field>
        <field name="res_model">fiscal.py.inutilization</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'create': False}</field>
    </record>

    <record id="view_py_sifen_inutilization_wizard_form" model="ir.ui.view">
        <field name="name">py.sifen.inutilization.wizard.form</field>
        <field name="model">py.sifen.inutilization.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm SIFEN Number Inutilization">
                <group>
                    <field name="adapter_config_id"/>
                    <field name="environment_label" readonly="1"/>
                    <field name="timbrado_id"/>
                    <field name="establishment_id"/>
                    <field name="point_of_issue_id"/>
                    <field name="document_type" readonly="1"/>
                </group>
                <group string="Unused Range">
                    <field name="number_from"/>
                    <field name="number_to"/>
                    <field name="occurred_on"/>
                    <field name="reason" placeholder="Explain why this number range was not used..."/>
                </group>
                <group>
                    <field name="warning" nolabel="1" colspan="2"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Confirm and Inutilize in SIFEN" class="btn-danger"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_py_sifen_inutilization_wizard" model="ir.actions.act_window">
        <field name="name">Inutilize Paraguay Number Range</field>
        <field name="res_model">py.sifen.inutilization.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_py_sifen_inutilization_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
