<odoo>
    <record id="view_tax_form_paraguay_sifen" model="ir.ui.view">
        <field name="name">account.tax.form.paraguay.sifen</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='country_id']" position="after">
                <field name="py_sifen_tax_treatment"/>
            </xpath>
        </field>
    </record>
</odoo>
