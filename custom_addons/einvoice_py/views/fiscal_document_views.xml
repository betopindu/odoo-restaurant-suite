<odoo>
    <record id="view_fiscal_document_form_py" model="ir.ui.view">
        <field name="name">fiscal.document.form.paraguay</field>
        <field name="model">fiscal.document</field>
        <field name="inherit_id" ref="einvoice_module.view_fiscal_document_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group[field[@name='country_code']]" position="after">
                <group string="Paraguay Information" invisible="country_code != 'PY'">
                    <field name="py_establishment_id"/>
                    <field name="py_point_of_issue_id"/>
                    <field name="py_timbrado_id"/>
                    <field name="py_csc_id"/>
                    <field name="py_issuer_id"/>
                    <field name="py_issuer_ruc"/>
                    <field name="py_issuer_ruc_dv"/>
                    <field name="py_issuer_taxpayer_type"/>
                    <field name="py_document_number"/>
                    <field name="py_full_number"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
