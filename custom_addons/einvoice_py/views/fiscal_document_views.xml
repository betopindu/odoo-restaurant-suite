<odoo>
    <record id="view_fiscal_document_form_py" model="ir.ui.view">
        <field name="name">fiscal.document.form.paraguay</field>
        <field name="model">fiscal.document</field>
        <field name="inherit_id" ref="einvoice_module.view_fiscal_document_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_download_paraguay_kude"
                        type="object"
                        string="Download KuDE"
                        class="btn-secondary"
                        invisible="country_code != 'PY' or state != 'accepted'"/>
                <button name="action_download_paraguay_xml"
                        type="object"
                        string="Download XML"
                        class="btn-secondary"
                        invisible="country_code != 'PY' or state != 'accepted'"/>
            </xpath>
            <xpath expr="//sheet/group[field[@name='country_code']]" position="after">
                <group string="Fiscal Identification" invisible="country_code != 'PY'">
                    <group string="Issuer and Authorization">
                        <field name="py_issuer_id" string="Issuer"/>
                        <field name="py_issuer_ruc" string="Issuer RUC Snapshot" readonly="1"/>
                        <field name="py_issuer_ruc_dv" string="Issuer RUC DV Snapshot" readonly="1"/>
                        <field name="py_issuer_taxpayer_type" string="Issuer Taxpayer Type Snapshot" readonly="1"/>
                        <field name="py_timbrado_id" string="Timbrado"/>
                    </group>
                    <group string="Numbering and CDC">
                        <field name="py_establishment_id" string="Establishment"/>
                        <field name="py_point_of_issue_id" string="Point of Issue"/>
                        <field name="py_csc_id" string="CSC"/>
                        <field name="py_document_number" string="Document Number" readonly="1"/>
                        <field name="py_full_number" string="Full Number" readonly="1"/>
                        <field name="py_emission_type" string="Emission Type"/>
                        <field name="py_cdc" string="CDC" readonly="1"/>
                    </group>
                    <group string="Technical CDC Values">
                        <field name="py_cod_seg" string="Security Code" readonly="1"/>
                        <field name="py_cdc_dv" string="CDC Check Digit" readonly="1"/>
                        <field name="py_cdc_base" string="CDC Base" readonly="1"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//field[@name='line_ids']/tree" position="inside">
                <field name="py_internal_code" optional="hide"/>
                <field name="py_unit_measure_code" optional="hide"/>
                <field name="py_unit_measure_description" optional="hide"/>
                <field name="py_tax_affectation" optional="show"/>
                <field name="py_tax_rate" string="Tax Rate" optional="show"/>
                <field name="py_tax_proportion" optional="hide"/>
                <field name="py_tax_base" optional="show"/>
                <field name="py_tax_amount" string="Tax Amount" optional="show"/>
                <field name="py_exempt_base" optional="hide"/>
                <field name="py_discount_amount" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']" position="inside">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="sequence"/>
                                <field name="product_name"/>
                                <field name="description"/>
                                <field name="quantity"/>
                                <field name="price_unit"/>
                            </group>
                            <group>
                                <field name="subtotal"/>
                                <field name="tax_amount"/>
                                <field name="total"/>
                            </group>
                        </group>
                        <group string="Tax Details">
                            <group>
                                <field name="py_internal_code" string="Internal Code"/>
                                <field name="py_unit_measure_code" string="Unit Measure Code"/>
                                <field name="py_unit_measure_description" string="Unit Measure Description"/>
                                <field name="py_tax_affectation" string="Tax Affectation"/>
                                <field name="py_tax_rate" string="Tax Rate"/>
                            </group>
                            <group>
                                <field name="py_tax_proportion" string="Tax Proportion"/>
                                <field name="py_tax_base" string="Tax Base"/>
                                <field name="py_tax_amount" string="Tax Amount"/>
                                <field name="py_exempt_base" string="Exempt Base"/>
                                <field name="py_discount_amount" string="Discount Amount"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Receiver Information" invisible="country_code != 'PY'">
                    <group>
                        <group string="Receiver Fiscal Identity">
                            <field name="py_receiver_nature"/>
                            <field name="py_receiver_taxpayer_type"/>
                            <field name="py_receiver_operation_type"/>
                            <field name="py_receiver_id_type"/>
                            <field name="py_receiver_id_type_description"/>
                            <field name="py_receiver_id_number"/>
                            <field name="py_receiver_customer_code"/>
                        </group>
                        <group string="Receiver Contact and Geography">
                            <field name="py_receiver_country_code"/>
                            <field name="py_receiver_country_description"/>
                            <field name="py_receiver_address"/>
                            <field name="py_receiver_house_number"/>
                            <field name="py_receiver_phone"/>
                            <field name="py_receiver_department_code"/>
                            <field name="py_receiver_department_name"/>
                            <field name="py_receiver_district_code"/>
                            <field name="py_receiver_district_name"/>
                            <field name="py_receiver_city_code"/>
                            <field name="py_receiver_city_name"/>
                        </group>
                    </group>
                </page>
                <page string="Operation Information" invisible="country_code != 'PY'">
                    <group>
                        <field name="py_transaction_type_code"/>
                        <field name="py_tax_type_code"/>
                        <field name="py_currency" string="Currency"/>
                        <field name="py_exchange_rate"/>
                    </group>
                </page>
                <page string="Payment Information" invisible="country_code != 'PY'">
                    <group>
                        <field name="py_sale_condition_code"/>
                        <field name="py_payment_type_code"/>
                        <field name="py_payment_amount"/>
                        <field name="py_payment_currency"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
