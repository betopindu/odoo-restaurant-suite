<odoo>
    <record id="view_fiscal_py_csc_tree" model="ir.ui.view">
        <field name="name">fiscal.py.csc.tree</field>
        <field name="model">fiscal.py.csc</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="id_csc"/>
                <field name="tenant_id"/>
                <field name="company_id"/>
                <field name="environment"/>
                <field name="valid_from"/>
                <field name="valid_to"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_fiscal_py_csc_form" model="ir.ui.view">
        <field name="name">fiscal.py.csc.form</field>
        <field name="model">fiscal.py.csc</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="id_csc"/>
                        <field name="tenant_id"/>
                        <field name="company_id"/>
                        <field name="environment"/>
                        <field name="active"/>
                    </group>
                    <group string="Validity">
                        <field name="valid_from"/>
                        <field name="valid_to"/>
                    </group>
                    <group string="Secret" groups="base.group_system">
                        <field name="csc_value"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fiscal_py_csc" model="ir.actions.act_window">
        <field name="name">Paraguay CSC</field>
        <field name="res_model">fiscal.py.csc</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
