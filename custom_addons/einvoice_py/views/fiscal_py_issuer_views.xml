<odoo>
    <record id="view_fiscal_py_issuer_tree" model="ir.ui.view">
        <field name="name">fiscal.py.issuer.tree</field>
        <field name="model">fiscal.py.issuer</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="tenant_id"/>
                <field name="company_id"/>
                <field name="environment"/>
                <field name="ruc"/>
                <field name="ruc_dv"/>
                <field name="taxpayer_type"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_fiscal_py_issuer_form" model="ir.ui.view">
        <field name="name">fiscal.py.issuer.form</field>
        <field name="model">fiscal.py.issuer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="tenant_id"/>
                        <field name="company_id"/>
                        <field name="environment"/>
                        <field name="active"/>
                    </group>
                    <group string="Fiscal Identity">
                        <field name="ruc"/>
                        <field name="ruc_dv"/>
                        <field name="taxpayer_type"/>
                    </group>
                    <group string="Economic Activities">
                        <field name="economic_activity_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="code"/>
                                <field name="description"/>
                                <field name="active"/>
                            </tree>
                        </field>
                    </group>
                    <group string="Notes">
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fiscal_py_issuer" model="ir.actions.act_window">
        <field name="name">Paraguay Issuers</field>
        <field name="res_model">fiscal.py.issuer</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
