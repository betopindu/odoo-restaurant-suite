<odoo>
    <record id="view_py_sifen_cancellation_wizard_form" model="ir.ui.view">
        <field name="name">py.sifen.cancellation.wizard.form</field>
        <field name="model">py.sifen.cancellation.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm SIFEN Cancellation">
                <group>
                    <field name="document_id" invisible="1"/>
                    <field name="document_reference"/>
                    <field name="environment_label"/>
                    <field name="cdc"/>
                    <field name="reason" placeholder="Explain why the accepted DTE must be cancelled..."/>
                </group>
                <group>
                    <field name="warning" nolabel="1" colspan="2"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Confirm and Cancel in SIFEN" class="btn-danger"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
