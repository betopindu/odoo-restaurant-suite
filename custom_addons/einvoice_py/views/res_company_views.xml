<odoo>
    <record id="view_company_form_py_fiscal_email" model="ir.ui.view">
        <field name="name">res.company.form.paraguay.fiscal.email</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='email']" position="after">
                <field name="py_fiscal_email_from"/>
                <field name="py_auto_email_accepted_fiscal_documents"/>
            </xpath>
        </field>
    </record>
</odoo>
