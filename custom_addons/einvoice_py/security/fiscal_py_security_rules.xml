<odoo>
    <record id="rule_fiscal_py_issuer_user_allowed" model="ir.rule">
        <field name="name">Paraguay issuers: allowed tenants</field>
        <field name="model_id" ref="model_fiscal_py_issuer"/>
        <field name="domain_force">[('tenant_id', 'in', user.allowed_fiscal_tenant_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

