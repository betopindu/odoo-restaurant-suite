<odoo>
    <record id="view_fiscal_api_key_tree" model="ir.ui.view">
        <field name="name">fiscal.api.key.tree</field>
        <field name="model">fiscal.api.key</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="key_prefix"/>
                <field name="tenant_id"/>
                <field name="company_id"/>
                <field name="default_processing_mode"/>
                <field name="last_used_at"/>
                <field name="expires_at"/>
                <field name="revoked_at"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_fiscal_api_key_form" model="ir.ui.view">
        <field name="name">fiscal.api.key.form</field>
        <field name="model">fiscal.api.key</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_api_key"
                            type="object"
                            string="Generate New Key"
                            class="btn-primary"
                            groups="base.group_system"
                            confirm="Generating a new key invalidates the currently stored key. Continue?"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="key_prefix"/>
                            <field name="active"/>
                            <field name="default_processing_mode"/>
                        </group>
                        <group>
                            <field name="tenant_id"/>
                            <field name="company_id"/>
                            <field name="last_used_at"/>
                            <field name="expires_at"/>
                            <field name="revoked_at"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fiscal_api_key" model="ir.actions.act_window">
        <field name="name">API Keys</field>
        <field name="res_model">fiscal.api.key</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_fiscal_api_keys"
              name="API Keys"
              parent="einvoice_module.menu_fiscal_configuration"
              action="action_fiscal_api_key"
              groups="base.group_system"
              sequence="30"/>
</odoo>
